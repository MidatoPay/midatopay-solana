# Database
DATABASE_URL="postgresql://postgres:admin123@localhost:5433/midatopay_solana"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Solana / Anchor Configuration
SOLANA_CLUSTER=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_WALLET_PATH=~/.config/solana/devnet-alt.json
SOLANA_PAYMENT_GATEWAY_PROGRAM_ID=DpVyTLLtthqVWsiGjoz3hWnvF8ugHTqhRsB1SY9Rp5zu
SOLANA_ORACLE_PROGRAM_ID=BwaGWVKhAQEUNENoXdnPDeciT4ct97s3u5mRjE4iJMkP
SOLANA_USDC_MINT=ESRwzP19W4xsc69xaxpSAnrttFH4K4JxERyBjMS4h68W
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
WALLET_ENCRYPTION_KEY="change-me-32-bytes-minimum"

# CriptoYa → oracle on-chain (dynamic_fx_oracle set_price). SOLANA_WALLET_PATH debe ser admin del oracle.
# Desactivar: CRIPTOYA_ORACLE_SYNC_ENABLED=false (solo lectura del precio en cadena, sin txs automáticas).
CRIPTOYA_ORACLE_SYNC_ENABLED=true
CRIPTOYA_API_BASE=https://criptoya.com/api
CRIPTOYA_EXCHANGE=fiwind
CRIPTOYA_COIN=USDC
CRIPTOYA_FIAT=ARS
CRIPTOYA_VOLUME=0.1
# ask | bid | mid
CRIPTOYA_PRICE_SIDE=ask
CRIPTOYA_MIN_CHAIN_INTERVAL_MS=60000
CRIPTOYA_TIMEOUT_MS=20000


# Blockchain
USDC_DECIMALS=6

# WebSocket
WS_PORT=3002

# Rate Limiting (opcional; si no existen, el servidor usa defaults por NODE_ENV)
# Producción por defecto: ventana 15 min, max 100.
# Desarrollo por defecto: ventana 1 min, max 2000 (evita 429 al trabajar con UI + scripts).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=2000

# Email Configuration (Resend)
RESEND_API_KEY=re_placeholder

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://sound-thrush-66.clerk.accounts.dev/.well-known/jwks.json
